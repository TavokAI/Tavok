{
  "name": "tavok",
  "version": "0.3.0",
  "private": true,
  "description": "AI-native self-hostable chat platform",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write 'packages/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "format:check": "prettier --check 'packages/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "typecheck": "pnpm --filter web typecheck",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:studio": "pnpm --filter web db:studio",
    "db:seed": "pnpm --filter web db:seed"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prisma": "6.19.3",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.5",
      "flatted": "3.4.2",
      "postcss": "8.5.12",
      "vite": "7.3.2"
    }
  }
}
